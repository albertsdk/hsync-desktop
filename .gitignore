# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
**/*.pyc
**/__pycache__
*.pyo

# Virtual environment
.env
.venv
venv/
ENV/

# Git
.git
.gitignore
.gitattributes

# Unit test / coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.tox/
.nox/

# Build / Distribution
/build/
/dist/
/tmp/
*.egg-info/
*.egg
*.whl

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db

# Project specific
/buckets/
/certs/

# Logs
*.log

# Qt specific (for hsync-desktop)
*.qmlc
*.jsc

# Python compiled
# PyInstaller auto-generated spec (compile.sh removes it on success but it can
# linger if the build is interrupted).
*.spec
# ...but the hand-written RPM spec under packaging/rpm/ must be tracked.
!packaging/rpm/*.spec

# Poetry lock (optional - comment if you want to commit poetry.lock)
# poetry.lock
hsync_desktop/bin/

# Kilo
.kilo

# Cache
.mypy_cache
.ruff_cache

# AppImage — appimagetool is downloaded at build time.
packaging/appimage/.cache/

# HSYNC
.hsynckeep
