<?xml version="1.0" encoding="UTF-8"?>
<!--
  Qt Resource Collection file for HSYNC Desktop.
  
  This file defines resources (icons, images, etc.) that can be embedded
  in the application and accessed via the Qt resource system.
  
  Usage in Python:
    from PySide6.QtGui import QIcon
    icon = QIcon(":/icons/app_icon.png")
  
  To compile this file to Python:
    pyside6-rcc resources.qrc -o resources_rc.py
  
  Then import in your application:
    import hsync_desktop.resources.resources_rc
-->
<RCC>
  <qresource prefix="/icons">
